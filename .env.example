# --------------------------------------------------------------------------
# Copia este archivo a .env y rellena los valores reales.
# El .env NUNCA se sube al repositorio (está en .gitignore).
# --------------------------------------------------------------------------

# --- Cliente (se incluyen en el bundle del navegador: NUNCA poner secretos) ---

# URL base del sitio, usada para las etiquetas canónicas y og: del SEO
VITE_SITE_URL=https://www.peopleasociacion.com

# Ruta del endpoint que recibe el formulario de contacto
VITE_API_URL=/api


# --- Servidor (solo accesibles desde api/, jamás llegan al navegador) ---

# Clave de la API de Resend (https://resend.com) para enviar los correos.
# Se configura en Vercel: Settings > Environment Variables.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend. Debe ser un dominio validado por vosotras.
CONTACT_FROM_EMAIL=web@peopleasociacion.com

# Buzón que recibe los mensajes del formulario de contacto
CONTACT_TO_EMAIL=info@peopleasociacion.com
